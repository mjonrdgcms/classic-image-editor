{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Classic Image Editor",
  "version": "0.12.0",
  "identifier": "app.classicimageeditor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Classic Image Editor",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' blob: data: ipc: http://ipc.localhost http://localhost:11434"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "cie"
        ],
        "name": "Classic Image Editor Image",
        "description": "Classic Image Editor layered image",
        "role": "Editor",
        "mimeType": "application/x-classic-image-editor"
      }
    ],
    "category": "Graphics and Design",
    "shortDescription": "A fast, offline image editor in the spirit of classic Photoshop 7",
    "linux": {
      "deb": {
        "depends": [
          "curl"
        ],
        "section": "graphics"
      },
      "rpm": {
        "depends": [
          "curl"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
